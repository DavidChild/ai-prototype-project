# Public domain name or server IP used by Nginx. Required.
DOMAIN=prototype.example.com

# Let's Encrypt SSL. DNS must already point DOMAIN to this server, with ports 80/443 open.
ENABLE_HTTPS=1
LETSENCRYPT_EMAIL=

# Open HTTP/HTTPS in an active firewalld instance (common on CentOS/Rocky/Alma).
OPEN_FIREWALL=1

# Build memory protection. Set BUILD_SWAP_SIZE_MB=0 to disable automatic Swap.
MIN_BUILD_MEMORY_MB=4096
BUILD_SWAP_SIZE_MB=4096
SWAP_FILE=/var/lib/xiaodou-prototype/build.swap

# Deployment layout.
APP_ROOT=/opt/xiaodou-prototype
APP_USER=xiaodou
APP_PORT=4173

# Existing MySQL/MariaDB service.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=db_proto

# Set to 0 when the database already exists and MYSQL_USER cannot create databases.
CREATE_DATABASE=1

# Optional. The first deployment generates and persists this key automatically.
# To supply your own, uncomment it once and keep the value stable thereafter.
# QUICKPAGE_CREDENTIAL_KEY=replace-with-output-of-openssl-rand-hex-32
